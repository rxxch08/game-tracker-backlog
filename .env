# Copy this file to .env and fill in the values
NODE_ENV=development
PORT=4000

# Local development (server run on the host, database in Docker)
DATABASE_URL=postgres://backlog:backlog@localhost:5433/backlog_clear

# Frontend origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Generate each one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-32-chars-min
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string-32-chars-min

# Free key at https://rawg.io/apidocs
RAWG_API_KEY=
